{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Synth",
  "version": "0.4.1",
  "identifier": "dev.synth.voice",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3118",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Synth",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "decorations": true,
        "url": "voice.html"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' http://127.0.0.1:18280 http://127.0.0.1:20129 http://127.0.0.1:18281"
      },
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main window capability with file system and media access",
          "windows": [
            "main"
          ],
          "permissions": [
            "fs:default",
            "fs:allow-read-file",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-download-write",
            "fs:allow-download-read",
            "fs:scope-download",
            "core:path:default",
            "core:event:default",
            "core:window:default",
            "core:app:default",
            "core:resources:default",
            "core:menu:default",
            "core:tray:default",
            "core:window:allow-set-title",
            "store:default",
            "notification:default",
            "notification:allow-is-permission-granted",
            "process:default",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$APPDATA/*"
                }
              ],
              "deny": [
                {
                  "path": "$APPDATA/desktop-api-key*"
                },
                {
                  "path": "$APPDATA/desktop-identity.json*"
                },
                {
                  "path": "$APPDATA/voice/**"
                },
                {
                  "path": "$APPDATA/pipeline/**"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png",
      "icons/app_icon.icns",
      "icons/app_icon.ico"
    ],
    "resources": [
      "templates/*.json"
    ],
    "externalBin": [
      "binaries/llama-helper",
      "binaries/ffmpeg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
    }
  },
  "plugins": {}
}
