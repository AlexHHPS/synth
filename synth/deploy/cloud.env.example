# Server-only values; never include these secrets in desktop builds.
AUTH_MODE=supabase
SYNTH_RUN_MIGRATIONS=0
ALLOWED_DOMAINS=example.com
SUPABASE_URL=https://exampleproject.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_CHECK_SESSIONS=1
DATABASE_URL=postgresql://synth_voice_backend:replace-password@db.example.com:5432/postgres
DATABASE_SCHEMA=synth_voice
DATABASE_SSLROOTCERT=/app/synth/deploy/supabase-ca.crt
BOOTSTRAP_ADMIN_KEY=replace-with-random-server-bootstrap-key
VOICE_PROFILE_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
BUILD_FINGERPRINT=replace-with-source-commit
OMNIROUTE_URL=https://gateway.example.com/v1
OMNIROUTE_COMBO=your-configured-combo
OMNIROUTE_API_KEY=replace-with-gateway-key
# Optional private adapter, configure only if deployed:
# HERMES_URL=http://hermes:18284/v1
# HERMES_API_KEY=replace-with-private-adapter-key
